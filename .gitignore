debug.keystore

# Signing material. A keystore that is committed is a keystore that has leaked;
# it can never be rotated by the people who would need to.
*.jks
*.keystore
*.p12
keystore.properties

# Build outputs that carry the R8 mapping or a stack trace with names in it.
*.map
mapping.txt

# Python tooling (tools/ is dependency free and needs no virtualenv)
__pycache__/
*.pyc

# Generated by tools/extract_strings.py --dry-run: a working list, not a source.
tools/strings_pending.json

# The installed workflow is generated by tools/install_ci.py from
# .github/ci/ci.yml. The installed copy is not committed: an identity without
# `workflows` permission cannot push it, and two copies of the same pipeline in
# the tree is how they drift.
.github/workflows/
