root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# Kotlin official code style: no wildcard imports, trailing commas on
# multi-line argument lists where the compiler accepts them.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_packages_to_use_import_on_demand = unset

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4
max_line_length = 120

[gradlew.bat]
end_of_line = crlf

[*.xml]
indent_size = 4
